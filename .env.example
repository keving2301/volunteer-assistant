# Server variables for the Netlify Functions (set in Netlify as secret variables scoped to functions).
# For local development put them in a file outside the repository and start Vite with VAS_ENV_FILE=<path> npm run dev.

# Firebase project and the service account the functions use (role: Cloud Datastore User only).
FIREBASE_PROJECT_ID=volunteer-assistant-kg
FIREBASE_CLIENT_EMAIL=
# The private key from the service account JSON, with its line breaks written as \n.
FIREBASE_PRIVATE_KEY=

# At least 32 random bytes, base64. Signs the session cookie and hashes visitor IPs for the workspace limit.
SESSION_SECRET=
